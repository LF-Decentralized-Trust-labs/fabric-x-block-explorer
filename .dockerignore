# The root image builds the Go backend (cmd/, pkg/, go.mod/sum,
# config.docker.yaml) and the combined backend+UI image.
# The ui/ directory is included so the combined Dockerfile can build it.

# VCS / CI / editor
.git
.github
.vscode
.DS_Store

# UI build artifacts (not source — the Dockerfile runs npm ci + build inside Docker)
ui/node_modules
ui/.next
ui/out
ui/.env
ui/.env.*.local

# Docs and markdown
docs
*.md

# Local-only config (may contain secrets) — never ship in the image
config.local.yaml
config.yaml
.env
.env.*

# Build artifacts / binaries / coverage
/explorer
bin/
dist/
coverage/
*.exe
*.dll
*.so
*.dylib

# Logs / temp
*.log
*.tmp
nohup.out

# Compose / docker
docker-compose*.yaml
.dockerignore
# Exclude individual docker image directories that are not needed at build time.
# docker/images/combined/ must remain accessible so start.sh can be COPYed.
docker/images/release/
docker/images/ui/
