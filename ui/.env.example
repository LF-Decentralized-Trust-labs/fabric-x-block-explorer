# Local `npm run dev` config. Next.js auto-loads .env / .env.local from this dir.
# (For Docker/Compose, configure these in the repo-root .env instead.)

# Backend the /api proxy forwards to, read at runtime by:
#   - app/api/[...path]/route.ts  (the catch-all proxy)
#   - app/api/config/route.ts     (exposes the URL to the sidebar widget)
BACKEND_URL=http://localhost:8080
